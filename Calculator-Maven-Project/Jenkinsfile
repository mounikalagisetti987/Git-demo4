pipeline {
    agent any

     environment {
        TOMCAT_SERVER = 'ubuntu@13.184.19.144'
        TOMCAT_PATH = '/opt/tomcat'
        WAR_FILE = 'Calculator-Maven-Project/target/Calculator.war'
    }

    stages {

        stage('Git Checkout') {
            steps {
                 checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                dir('Calculator-Maven-Project')
                {
                 sh 'mvn clean compile'
                 sh 'mvn test'
                 sh 'mvn package'
                }
            }
        }

               
        stage('Deploy to Tomcat') {
            steps {
                sshagent(credentials:['TOMCAT_SERVER']){
                sh """
                scp -o StrictHostKeyChecking=yes ${WAR_FILE} ${TOMCAT_SERVER}:/tmp/Calculator.war

                ssh -o StrictHostKeyChecking=yes ${TOMCAT_SERVER} '
                    sudo mv /tmp/Calculator.war ${TOMCAT_PATH}/webapps/Calculator.war
                '
                """
            }
        }
    }
    }
}
